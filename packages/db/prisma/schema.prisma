// StageDesk v2 schema. Conventions:
// - money is integer cents (Int), percentages are basis points (Int)
// - every tenant table gets organizationId + an index on it
// - table names are snake_case plural via @@map

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

// ─── Identity and agencies ──────────────────────────────────────────────
// Managed by Better Auth (apps/web/src/lib/auth-config.ts). Regenerate a
// reference with `pnpm dlx auth generate` after changing plugins, then
// merge by hand: model and field names must match what Better Auth expects.

model User {
  id               String            @id @db.VarChar(64)
  name             String            @db.VarChar(191)
  email            String            @unique @db.VarChar(191)
  emailVerified    Boolean           @default(false)
  image            String?           @db.Text
  twoFactorEnabled Boolean?          @default(false)
  /// "platform_admin" | "affiliate" | null. Never accepted from client input.
  platformRole     String?           @db.VarChar(32)
  locale           String?           @default("nl") @db.VarChar(8)
  /// Set by the platform admin: the user can't sign in.
  disabledAt       DateTime?
  phone            String?           @db.VarChar(32)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         Session[]
  accounts         Account[]
  members          Member[]
  invitations      Invitation[]
  twofactors       TwoFactor[]
  artistProfiles   Artist[]
  bookings         Booking[]         @relation("BookingCustomer")
  reviews          Review[]
  affiliate        Affiliate?
  notifications    Notification[]
  bookingMessages  BookingMessage[]
  supportTickets   SupportTicket[]
  ticketMessages   TicketMessage[]
  legalAcceptances LegalAcceptance[]

  @@map("users")
}

model Session {
  id                    String   @id @db.VarChar(64)
  token                 String   @unique @db.VarChar(191)
  expiresAt             DateTime
  ipAddress             String?  @db.VarChar(64)
  userAgent             String?  @db.Text
  userId                String   @db.VarChar(64)
  /// Platform admins only: the agency they're working in as support (set by the server, never by the client).
  supportOrganizationId String?  @db.VarChar(64)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId  String?  @db.VarChar(64)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @db.VarChar(64)
  accountId             String    @db.VarChar(191)
  providerId            String    @db.VarChar(64)
  userId                String    @db.VarChar(64)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @db.VarChar(64)
  identifier String   @db.VarChar(191)
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

/// An agency (tenant).
model Organization {
  id                 String                 @id @db.VarChar(64)
  name               String                 @db.VarChar(191)
  slug               String                 @unique @db.VarChar(191)
  logo               String?                @db.Text
  metadata           String?                @db.Text
  kvkNumber          String?                @db.VarChar(16)
  vatNumber          String?                @db.VarChar(20)
  contactEmail       String?                @db.VarChar(191)
  phone              String?                @db.VarChar(32)
  website            String?                @db.VarChar(191)
  addressLine        String?                @db.VarChar(191)
  postalCode         String?                @db.VarChar(16)
  city               String?                @db.VarChar(96)
  brandColor         String?                @db.VarChar(16)
  /// Public booking page at /b/<slug>.
  bookingPageEnabled Boolean                @default(true)
  bookingIntro       String?                @db.Text
  coverUrl           String?                @db.Text
  /// { question: string; answer: string }[]
  faq                Json?
  showReviews        Boolean                @default(true)
  stripeCustomerId   String?                @unique @db.VarChar(64)
  /// Platform fee deal for this agency (FeeRule); overrides the plan and platform default.
  feeRule            Json?
  /// Set by the platform admin: the agency team is locked out and the booking page is offline. Data is kept.
  suspendedAt        DateTime?
  suspendReason      String?                @db.VarChar(191)
  /// Internal notes, only visible to platform admins.
  adminNotes         String?                @db.Text
  createdAt          DateTime               @default(now())
  subscription       Subscription?
  connectedAccounts  ConnectedAccount[]
  ledger             LedgerEntry[]
  /// Give-a-month code other agencies sign up with (e.g. r-k7q2m9).
  referralCode       String?                @unique @db.VarChar(24)
  referral           Referral?              @relation("ReferredAgency")
  referredAgencies   Referral[]             @relation("ReferringAgency")
  bookingMessages    BookingMessage[]
  members            Member[]
  invitations        Invitation[]
  artists            Artist[]
  unavailable        ArtistUnavailability[]
  sharesOut          ArtistShare[]          @relation("ShareOwner")
  sharesIn           ArtistShare[]          @relation("SharePartner")
  bookings           Booking[]
  assignments        BookingAssignment[]
  events             BookingEvent[]
  notes              BookingNote[]
  services           ServiceItem[]
  quotes             Quote[]
  quoteItems         QuoteItem[]
  payments           Payment[]
  invoices           Invoice[]
  counters           OrganizationCounter[]
  reviews            Review[]

  leadsAssigned Lead[]      @relation("LeadAgency")
  leadOffers    LeadOffer[] @relation("LeadOffers")

  /// Payment methods the agency offers its customers (within what the platform allows).
  acceptOnline        Boolean        @default(true)
  acceptBankTransfer  Boolean        @default(true)
  acceptCash          Boolean        @default(false)
  iban                String?        @db.VarChar(34)
  bankAccountName     String?        @db.VarChar(191)
  /// Shown to customers with the bank details, e.g. "Please pay within 7 days".
  paymentInstructions String?        @db.Text
  paymentClaims       PaymentClaim[]

  @@map("organizations")
}

/// A user's role in one agency: agency_owner, agency_admin, agency_staff, artist, customer.
model Member {
  id             String       @id @db.VarChar(64)
  organizationId String       @db.VarChar(64)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @db.VarChar(64)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @db.VarChar(32)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([organizationId, role])
  @@index([userId])
  @@map("members")
}

model Invitation {
  id             String       @id @db.VarChar(64)
  organizationId String       @db.VarChar(64)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @db.VarChar(191)
  role           String?      @db.VarChar(32)
  /// pending | accepted | rejected | canceled
  status         String       @db.VarChar(16)
  expiresAt      DateTime
  inviterId      String       @db.VarChar(64)
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId, status])
  @@index([email])
  @@map("invitations")
}

model TwoFactor {
  id                      String    @id @db.VarChar(64)
  secret                  String    @db.Text
  backupCodes             String    @db.Text
  userId                  String    @db.VarChar(64)
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([userId])
  @@map("two_factors")
}

model RateLimit {
  id          String @id @db.VarChar(64)
  key         String @unique @db.VarChar(191)
  count       Int
  lastRequest BigInt

  @@map("rate_limits")
}

// ─── Artists ────────────────────────────────────────────────────────────

/// A performer an agency books. userId links the artist's own login, if any.
model Artist {
  id                String                 @id @db.VarChar(64)
  organizationId    String                 @db.VarChar(64)
  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId            String?                @db.VarChar(64)
  user              User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  stageName         String                 @db.VarChar(120)
  bio               String?                @db.Text
  /// string[]
  genres            Json
  photoUrl          String?                @db.Text
  /// Shown on the agency's public booking page.
  showOnBookingPage Boolean                @default(true)
  /// string[]: YouTube, Vimeo, SoundCloud or Mixcloud links
  mediaLinks        Json?
  /// Default share of each booking payment, in basis points.
  defaultShareBps   Int                    @default(4000)
  active            Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  assignments       BookingAssignment[]
  unavailability    ArtistUnavailability[]
  shares            ArtistShare[]
  reviews           Review[]
  connectedAccount  ConnectedAccount?

  @@unique([organizationId, userId])
  @@index([organizationId, active])
  @@map("artists")
}

/// Dates an artist can't perform.
model ArtistUnavailability {
  id             String       @id @db.VarChar(64)
  organizationId String       @db.VarChar(64)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  artistId       String       @db.VarChar(64)
  artist         Artist       @relation(fields: [artistId], references: [id], onDelete: Cascade)
  date           DateTime     @db.Date
  note           String?      @db.VarChar(191)
  createdAt      DateTime     @default(now())

  @@unique([artistId, date])
  @@index([organizationId, date])
  @@map("artist_unavailability")
}

/// An agency lending one of its artists to a partner agency.
/// organizationId is the owner; the partner side is read via partnerOrganizationId.
model ArtistShare {
  id                    String       @id @db.VarChar(64)
  organizationId        String       @db.VarChar(64)
  organization          Organization @relation("ShareOwner", fields: [organizationId], references: [id], onDelete: Cascade)
  artistId              String       @db.VarChar(64)
  artist                Artist       @relation(fields: [artistId], references: [id], onDelete: Cascade)
  partnerOrganizationId String       @db.VarChar(64)
  partnerOrganization   Organization @relation("SharePartner", fields: [partnerOrganizationId], references: [id], onDelete: Cascade)
  /// pending | accepted | declined | revoked
  status                String       @db.VarChar(16)
  createdAt             DateTime     @default(now())
  respondedAt           DateTime?

  @@unique([artistId, partnerOrganizationId])
  @@index([organizationId, status])
  @@index([partnerOrganizationId, status])
  @@map("artist_shares")
}

// ─── Bookings ───────────────────────────────────────────────────────────

/// One event for one customer. Status changes go through transition() in core.
model Booking {
  id                String              @id @db.VarChar(64)
  organizationId    String              @db.VarChar(64)
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Public reference, e.g. K7Q2M9XA.
  trackingCode      String              @unique @db.VarChar(8)
  status            String              @default("inquiry") @db.VarChar(16)
  customerId        String?             @db.VarChar(64)
  customer          User?               @relation("BookingCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  eventType         String              @db.VarChar(24)
  eventDate         DateTime?           @db.Date
  startTime         String?             @db.VarChar(5)
  endTime           String?             @db.VarChar(5)
  venueName         String?             @db.VarChar(191)
  venueAddress      String?             @db.VarChar(191)
  venueCity         String?             @db.VarChar(96)
  guestCount        Int?
  budgetCents       Int?
  /// The customer's own words from the inquiry.
  message           String?             @db.Text
  partnerName       String?             @db.VarChar(191)
  /// string[]
  dos               Json?
  /// string[]
  donts             Json?
  playlistUrl       String?             @db.VarChar(500)
  /// From the public inquiry form.
  preferredArtistId String?             @db.VarChar(64)
  preferredGenre    String?             @db.VarChar(96)
  /// Key from core's budgetRanges, e.g. "750_1500".
  budgetRange       String?             @db.VarChar(16)
  ceremony          Boolean?
  /// manual | booking_page
  source            String              @default("manual") @db.VarChar(16)
  /// Copied from the accepted quote.
  totalCents        Int                 @default(0)
  depositCents      Int                 @default(0)
  /// Sum of received payments, kept in step by recordPayment().
  paidCents         Int                 @default(0)
  quoteExpiresAt    DateTime?
  /// { rule: FeeRule; stripeFeePaidBy } frozen when the quote is accepted.
  feeSnapshot       Json?
  /// A customer opened a card dispute; payouts wait until it's resolved.
  disputed          Boolean             @default(false)
  /// When Stripe money was transferred to the agency and artist.
  paidOutAt         DateTime?
  cancelReason      String?             @db.Text
  createdById       String?             @db.VarChar(64)
  quotedAt          DateTime?
  bookedAt          DateTime?
  confirmedAt       DateTime?
  completedAt       DateTime?
  settledAt         DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  assignments       BookingAssignment[]
  events            BookingEvent[]
  notes             BookingNote[]
  quotes            Quote[]
  payments          Payment[]
  invoices          Invoice[]
  review            Review?
  ledger            LedgerEntry[]
  messages          BookingMessage[]
  paymentClaims     PaymentClaim[]

  @@index([organizationId, status])
  @@index([organizationId, eventDate])
  @@index([customerId])
  @@map("bookings")
}

/// An artist asked to perform at a booking. One open assignment per booking.
model BookingAssignment {
  id             String       @id @db.VarChar(64)
  organizationId String       @db.VarChar(64)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookingId      String       @db.VarChar(64)
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  artistId       String       @db.VarChar(64)
  artist         Artist       @relation(fields: [artistId], references: [id], onDelete: Restrict)
  /// pending | accepted | declined | withdrawn
  status         String       @db.VarChar(16)
  /// Artist's share for this booking, copied when assigned.
  shareBps       Int
  declineReason  String?      @db.Text
  respondedAt    DateTime?
  createdAt      DateTime     @default(now())

  @@index([bookingId, status])
  @@index([artistId, status])
  @@index([organizationId])
  @@map("booking_assignments")
}

/// Timeline of everything that happened to a booking.
model BookingEvent {
  id             BigInt       @id @default(autoincrement())
  organizationId String       @db.VarChar(64)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookingId      String       @db.VarChar(64)
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type           String       @db.VarChar(32)
  actorId        String?      @db.VarChar(64)
  data           Json?
  createdAt      DateTime     @default(now())

  @@index([bookingId, createdAt])
  @@index([organizationId])
  @@map("booking_events")
}

/// Internal notes; never shown to customers or artists.
model BookingNote {
  id             String       @id @db.VarChar(64)
  organizationId String       @db.VarChar(64)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookingId      String       @db.VarChar(64)
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorId       String       @db.VarChar(64)
  body           String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([bookingId, createdAt])
  @@index([organizationId])
  @@map("booking_notes")
}

// ─── Quotes ─────────────────────────────────────────────────────────────

/// An agency's reusable quote lines, e.g. "DJ, per hour".
model ServiceItem {
  id             String       @id @db.VarChar(64)
  organizationId String       @db.VarChar(64)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String       @db.VarChar(191)
  description    String?      @db.Text
  /// hour | piece | flat
  unit           String       @db.VarChar(16)
  unitPriceCents Int
  vatBps         Int          @default(2100)
  active         Boolean      @default(true)
  position       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, active, position])
  @@map("service_items")
}

/// A versioned price offer for a booking. Totals are stored as sent.
model Quote {
  id             String       @id @db.VarChar(64)
  organizationId String       @db.VarChar(64)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookingId      String       @db.VarChar(64)
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  version        Int
  /// draft | sent | accepted | superseded | declined
  status         String       @db.VarChar(16)
  /// Secret for the customer's /q/<token> link.
  token          String       @unique @db.VarChar(64)
  notes          String?      @db.Text
  depositBps     Int
  subtotalCents  Int
  vatCents       Int
  totalCents     Int
  depositCents   Int
  /// VatGroup[]
  vatGroups      Json
  expiresAt      DateTime
  sentAt         DateTime?
  acceptedAt     DateTime?
  acceptedByName String?      @db.VarChar(191)
  createdById    String?      @db.VarChar(64)
  createdAt      DateTime     @default(now())
  items          QuoteItem[]

  @@unique([bookingId, version])
  @@index([organizationId, status])
  @@map("quotes")
}

model QuoteItem {
  id                 String       @id @db.VarChar(64)
  organizationId     String       @db.VarChar(64)
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quoteId            String       @db.VarChar(64)
  quote              Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  position           Int
  description        String       @db.VarChar(500)
  quantityHundredths Int
  unitPriceCents     Int
  vatBps             Int
  subtotalCents      Int

  @@index([quoteId, position])
  @@index([organizationId])
  @@map("quote_items")
}

// ─── Money ──────────────────────────────────────────────────────────────

/// Money received for a booking: recorded by hand (offline) or paid through Stripe.
model Payment {
  id                    String        @id @db.VarChar(64)
  organizationId        String        @db.VarChar(64)
  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bookingId             String        @db.VarChar(64)
  booking               Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  /// deposit | balance | other | refund (offline refunds are negative amounts)
  kind                  String        @db.VarChar(16)
  /// bank_transfer | cash | card | other | stripe
  method                String        @db.VarChar(24)
  amountCents           Int
  receivedAt            DateTime
  reference             String?       @db.VarChar(191)
  recordedById          String?       @db.VarChar(64)
  stripeCheckoutId      String?       @unique @db.VarChar(80)
  stripePaymentIntentId String?       @unique @db.VarChar(64)
  stripeChargeId        String?       @db.VarChar(64)
  stripeFeeCents        Int           @default(0)
  refundedCents         Int           @default(0)
  /// When this payment's split was transferred to the agency and artist.
  transferredAt         DateTime?
  createdAt             DateTime      @default(now())
  ledger                LedgerEntry[]

  @@index([bookingId])
  @@index([organizationId, receivedAt])
  @@map("payments")
}

/// Append-only record of every money movement. Amounts are signed cents
/// from the point of view of `party`; nothing here is ever edited.
model LedgerEntry {
  id             BigInt       @id @default(autoincrement())
  organizationId String       @db.VarChar(64)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bookingId      String?      @db.VarChar(64)
  booking        Booking?     @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  paymentId      String?      @db.VarChar(64)
  payment        Payment?     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  /// payment | stripe_fee | platform_fee | artist_share | agency_share | transfer | refund | transfer_reversal | dispute | owed_by_agency
  type           String       @db.VarChar(32)
  /// platform | agency | artist | stripe | customer
  party          String       @db.VarChar(16)
  amountCents    Int
  artistId       String?      @db.VarChar(64)
  stripeObjectId String?      @db.VarChar(64)
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([bookingId])
  @@index([artistId, type])
  @@map("ledger_entries")
}

// ─── Subscriptions and Stripe ───────────────────────────────────────────

/// A subscription plan, edited by the super admin and mirrored to Stripe.
model Plan {
  id                   String         @id @db.VarChar(64)
  key                  String         @unique @db.VarChar(48)
  /// { nl, en }
  name                 Json
  /// { nl, en }
  description          Json?
  monthlyPriceCents    Int
  yearlyPriceCents     Int
  trialDays            Int            @default(14)
  /// { nl: string[]; en: string[] } shown on the pricing page
  features             Json
  /// PlanLimits from @stagedesk/core
  limits               Json
  /// FeeRule for agencies on this plan; null uses the platform default.
  feeRule              Json?
  recommended          Boolean        @default(false)
  visible              Boolean        @default(true)
  active               Boolean        @default(true)
  position             Int            @default(0)
  stripeProductId      String?        @db.VarChar(64)
  stripeMonthlyPriceId String?        @db.VarChar(64)
  stripeYearlyPriceId  String?        @db.VarChar(64)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  subscriptions        Subscription[]

  @@map("plans")
}

/// An agency's subscription. Mirrors Stripe once the agency has paid.
model Subscription {
  id                   String       @id @db.VarChar(64)
  organizationId       String       @unique @db.VarChar(64)
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId               String       @db.VarChar(64)
  plan                 Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  /// trialing | active | past_due | unpaid | canceled | incomplete
  status               String       @db.VarChar(24)
  /// month | year
  interval             String       @default("month") @db.VarChar(8)
  stripeSubscriptionId String?      @unique @db.VarChar(64)
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean      @default(false)
  /// Start of a failed-payment period; read-only access begins after the grace days.
  pastDueSince         DateTime?
  /// Granted by the platform admin without Stripe (no invoices are sent).
  complimentary        Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([status])
  @@map("subscriptions")
}

/// A Stripe Express account for an agency (receives its share) or an artist.
model ConnectedAccount {
  id               String       @id @db.VarChar(64)
  organizationId   String       @db.VarChar(64)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Set for an artist's account; null for the agency's own.
  artistId         String?      @unique @db.VarChar(64)
  artist           Artist?      @relation(fields: [artistId], references: [id], onDelete: Cascade)
  stripeAccountId  String       @unique @db.VarChar(64)
  chargesEnabled   Boolean      @default(false)
  payoutsEnabled   Boolean      @default(false)
  detailsSubmitted Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId])
  @@map("connected_accounts")
}

/// Every Stripe webhook event, stored once by id so it's processed at most once.
model StripeEvent {
  id          String    @id @db.VarChar(80)
  type        String    @db.VarChar(80)
  /// received | processed | failed | ignored
  status      String    @default("received") @db.VarChar(16)
  error       String?   @db.Text
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([status, receivedAt])
  @@map("stripe_events")
}

/// Issued invoice. `data` is a snapshot so later edits don't change it.
model Invoice {
  id             String       @id @db.VarChar(64)
  organizationId String       @db.VarChar(64)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bookingId      String       @db.VarChar(64)
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  number         String       @db.VarChar(16)
  issuedAt       DateTime
  dueAt          DateTime?
  subtotalCents  Int
  vatCents       Int
  totalCents     Int
  data           Json
  createdAt      DateTime     @default(now())

  @@unique([organizationId, number])
  @@index([bookingId])
  @@map("invoices")
}

/// Per-agency sequences, e.g. invoice numbers per year.
model OrganizationCounter {
  organizationId String       @db.VarChar(64)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String       @db.VarChar(32)
  value          Int

  @@id([organizationId, key])
  @@map("organization_counters")
}

/// A customer's review after a completed booking; shown once approved.
model Review {
  id             String       @id @db.VarChar(64)
  organizationId String       @db.VarChar(64)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookingId      String       @unique @db.VarChar(64)
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId     String       @db.VarChar(64)
  customer       User         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  artistId       String?      @db.VarChar(64)
  artist         Artist?      @relation(fields: [artistId], references: [id], onDelete: SetNull)
  rating         Int
  comment        String?      @db.Text
  /// pending | approved | rejected
  status         String       @default("pending") @db.VarChar(16)
  moderatedAt    DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, status])
  @@index([artistId, status])
  @@map("reviews")
}

// ─── Platform settings ──────────────────────────────────────────────────

/// Typed key/value settings edited by the super admin. Keys and shapes are
/// defined in @stagedesk/core settingsRegistry.
model PlatformSetting {
  key         String   @id @db.VarChar(100)
  value       Json
  updatedById String?  @db.VarChar(64)
  updatedAt   DateTime @updatedAt

  @@map("platform_settings")
}

/// Append-only history of every settings change.
model SettingChange {
  id          BigInt   @id @default(autoincrement())
  key         String   @db.VarChar(100)
  oldValue    Json?
  newValue    Json
  changedById String?  @db.VarChar(64)
  changedAt   DateTime @default(now())

  @@index([key, changedAt])
  @@map("settings_history")
}

// ─── Affiliate program ──────────────────────────────────────────────────
// Platform-level: rows point at agencies through agencyId, not organizationId,
// so they are never read through an agency's tenantDb.

/// A partner who brings in agencies. Applies at /partners; the platform admin approves.
model Affiliate {
  id                    String            @id @db.VarChar(64)
  userId                String            @unique @db.VarChar(64)
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// pending | approved | rejected | suspended
  status                String            @default("pending") @db.VarChar(16)
  /// Link code: ?via=<code>
  code                  String            @unique @db.VarChar(24)
  /// Code agencies type at signup or checkout, e.g. PIM20.
  promoCode             String            @unique @db.VarChar(24)
  stripePromotionCodeId String?           @db.VarChar(64)
  website               String?           @db.VarChar(191)
  /// The application: who they reach and how.
  pitch                 String?           @db.Text
  /// Overrides tier and program rate for new referrals.
  commissionBps         Int?
  stripeAccountId       String?           @unique @db.VarChar(64)
  payoutsEnabled        Boolean           @default(false)
  approvedAt            DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  clicks                AffiliateClick[]
  referrals             Referral[]
  commissions           Commission[]
  payouts               AffiliatePayout[]

  @@index([status])
  @@map("affiliates")
}

model AffiliateClick {
  id          BigInt    @id @default(autoincrement())
  affiliateId String    @db.VarChar(64)
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  campaign    String?   @db.VarChar(48)
  landingPath String?   @db.VarChar(191)
  /// Hashed, never the raw IP.
  visitorHash String?   @db.VarChar(64)
  createdAt   DateTime  @default(now())

  @@index([affiliateId, createdAt])
  @@map("affiliate_clicks")
}

/// How an agency came to StageDesk. One per agency, stored permanently.
model Referral {
  id                String        @id @db.VarChar(64)
  agencyId          String        @unique @db.VarChar(64)
  agency            Organization  @relation("ReferredAgency", fields: [agencyId], references: [id], onDelete: Cascade)
  /// affiliate | agency (give a month, get a month)
  type              String        @db.VarChar(16)
  affiliateId       String?       @db.VarChar(64)
  affiliate         Affiliate?    @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  referringAgencyId String?       @db.VarChar(64)
  referringAgency   Organization? @relation("ReferringAgency", fields: [referringAgencyId], references: [id], onDelete: SetNull)
  /// cookie | promo_code
  source            String        @db.VarChar(16)
  campaign          String?       @db.VarChar(48)
  /// Frozen when the agency signed up.
  commissionBps     Int           @default(0)
  /// null = lifetime
  commissionMonths  Int?
  /// active | rejected (fraud rule)
  status            String        @default("active") @db.VarChar(16)
  rejectReason      String?       @db.VarChar(64)
  firstPaidAt       DateTime?
  /// Give-a-month credits applied.
  rewardedAt        DateTime?
  createdAt         DateTime      @default(now())
  commissions       Commission[]

  @@index([affiliateId, createdAt])
  @@index([referringAgencyId])
  @@map("referrals")
}

/// A share of one paid subscription invoice.
model Commission {
  id                    String           @id @db.VarChar(64)
  affiliateId           String           @db.VarChar(64)
  affiliate             Affiliate        @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  referralId            String           @db.VarChar(64)
  referral              Referral         @relation(fields: [referralId], references: [id], onDelete: Restrict)
  agencyId              String           @db.VarChar(64)
  stripeInvoiceId       String           @unique @db.VarChar(80)
  stripePaymentIntentId String?          @db.VarChar(64)
  /// Invoice amount paid, excluding VAT.
  baseCents             Int
  commissionBps         Int
  amountCents           Int
  /// pending | review | approved | paid | cancelled
  status                String           @default("pending") @db.VarChar(16)
  /// End of the approval window.
  availableAt           DateTime
  cancelReason          String?          @db.VarChar(64)
  payoutId              String?          @db.VarChar(64)
  payout                AffiliatePayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  createdAt             DateTime         @default(now())

  @@index([affiliateId, status])
  @@index([status, availableAt])
  @@index([stripePaymentIntentId])
  @@map("commissions")
}

model AffiliatePayout {
  id               String       @id @db.VarChar(64)
  affiliateId      String       @db.VarChar(64)
  affiliate        Affiliate    @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  amountCents      Int
  /// paid | failed
  status           String       @db.VarChar(16)
  stripeTransferId String?      @unique @db.VarChar(64)
  error            String?      @db.Text
  createdAt        DateTime     @default(now())
  commissions      Commission[]

  @@index([affiliateId, createdAt])
  @@map("affiliate_payouts")
}

/// Logos, banners, email templates and videos affiliates can use.
model AffiliateAsset {
  id          String   @id @db.VarChar(64)
  /// logo | banner | email | video | other
  kind        String   @db.VarChar(16)
  /// { nl, en }
  title       Json
  description Json?
  url         String   @db.VarChar(500)
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("affiliate_assets")
}

// ─── Messaging, notifications, support, audit ───────────────────────────

/**
 * A message in a booking's conversation.
 */
model BookingMessage {
  id             String       @id @db.VarChar(64)
  organizationId String       @db.VarChar(64)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookingId      String       @db.VarChar(64)
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  /// customer (agency with the customer) | artist (agency with the assigned artist)
  channel        String       @db.VarChar(16)
  authorId       String?      @db.VarChar(64)
  author         User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body           String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([bookingId, channel, createdAt])
  @@index([organizationId, createdAt])
  @@map("booking_messages")
}

/**
 * How far a user has read one conversation.
 */
model MessageRead {
  userId     String   @db.VarChar(64)
  bookingId  String   @db.VarChar(64)
  channel    String   @db.VarChar(16)
  lastReadAt DateTime

  @@id([userId, bookingId, channel])
  @@map("message_reads")
}

/**
 * In-app notification. Text comes from the type and data, in the reader's language.
 */
model Notification {
  id        String    @id @db.VarChar(64)
  userId    String    @db.VarChar(64)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// new_inquiry | quote_accepted | gig_request | gig_response | payment_received | message | ticket_reply | ticket_new | reminder_event | commission_approved
  type      String    @db.VarChar(40)
  data      Json
  /// Where clicking it goes, e.g. /app/bookings/K7Q2M9XA
  url       String?   @db.VarChar(255)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model SupportTicket {
  id            String          @id @db.VarChar(64)
  /// Shown to people, e.g. T-K7Q2M9
  reference     String          @unique @db.VarChar(12)
  userId        String          @db.VarChar(64)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The agency the user was working in, if any (platform-level, so not organizationId).
  agencyId      String?         @db.VarChar(64)
  subject       String          @db.VarChar(191)
  /// billing | bookings | payments | account | other
  category      String          @db.VarChar(16)
  /// open (waiting on support) | answered (waiting on the user) | closed
  status        String          @default("open") @db.VarChar(16)
  lastMessageAt DateTime        @default(now())
  closedAt      DateTime?
  createdAt     DateTime        @default(now())
  messages      TicketMessage[]

  @@index([status, lastMessageAt])
  @@index([userId, lastMessageAt])
  @@map("support_tickets")
}

model TicketMessage {
  id        String        @id @db.VarChar(64)
  ticketId  String        @db.VarChar(64)
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String?       @db.VarChar(64)
  author    User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  fromStaff Boolean       @default(false)
  body      String        @db.Text
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

/**
 * Who did what: admin, money and access changes. Append-only.
 */
model AuditEvent {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @db.VarChar(64)
  /// The agency affected, if any (platform-level, so not organizationId).
  agencyId   String?  @db.VarChar(64)
  /// e.g. settings.update, plan.save, agency.fee_deal, affiliate.status, payment.refund, user.disable
  action     String   @db.VarChar(64)
  targetType String?  @db.VarChar(32)
  targetId   String?  @db.VarChar(64)
  data       Json?
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([agencyId, createdAt])
  @@index([action, createdAt])
  @@map("audit_events")
}

/**
 * One row per reminder sent, so the hourly job never sends one twice.
 */
model ReminderLog {
  key    String   @id @db.VarChar(120)
  sentAt DateTime @default(now())

  @@map("reminder_logs")
}

// ─── Website: pages, legal, blog comments, waitlist ─────────────────────

/**
 * A page the super admin builds: About, Terms, Privacy and other footer or header pages.
 */
model Page {
  id                 String            @id @db.VarChar(64)
  slugNl             String            @unique @db.VarChar(96)
  slugEn             String            @unique @db.VarChar(96)
  /// standard | legal (legal pages show "last updated" and keep every published version)
  kind               String            @default("standard") @db.VarChar(16)
  /// terms | privacy | cookies | dpa | imprint: a fixed name so the app can link to it
  legalKey           String?           @unique @db.VarChar(16)
  /// none | all | agencies: who must accept a new published version at their next sign-in
  acceptance         String            @default("none") @db.VarChar(16)
  /// none | header | footer_product | footer_company | footer_legal
  placement          String            @default("none") @db.VarChar(24)
  position           Int               @default(0)
  /// draft | published
  status             String            @default("draft") @db.VarChar(16)
  publishedVersionId String?           @unique @db.VarChar(64)
  publishedVersion   PageVersion?      @relation("PublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  versions           PageVersion[]     @relation("PageVersions")
  acceptances        LegalAcceptance[]

  @@index([placement, position])
  @@map("pages")
}

/**
 * Every save is a version; one of them is published.
 */
model PageVersion {
  id           String            @id @db.VarChar(64)
  pageId       String            @db.VarChar(64)
  page         Page              @relation("PageVersions", fields: [pageId], references: [id], onDelete: Cascade)
  number       Int
  /// { nl: { title, seoTitle, seoDescription, blocks }, en: { ... } }
  content      Json
  /// What changed, shown in the history.
  note         String?           @db.VarChar(191)
  createdById  String?           @db.VarChar(64)
  createdAt    DateTime          @default(now())
  publishedAt  DateTime?
  publishedFor Page?             @relation("PublishedVersion")
  acceptances  LegalAcceptance[]

  @@unique([pageId, number])
  @@map("page_versions")
}

/**
 * Someone accepted one published version of a legal page.
 */
model LegalAcceptance {
  id         String      @id @db.VarChar(64)
  userId     String      @db.VarChar(64)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageId     String      @db.VarChar(64)
  page       Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  versionId  String      @db.VarChar(64)
  version    PageVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  acceptedAt DateTime    @default(now())
  ip         String?     @db.VarChar(64)

  @@unique([userId, versionId])
  @@index([pageId])
  @@map("legal_acceptances")
}

/**
 * A reader's comment on a blog post; shown after the admin approves it.
 */
model BlogComment {
  id          String   @id @db.VarChar(64)
  postSlug    String   @db.VarChar(120)
  locale      String   @db.VarChar(8)
  authorName  String   @db.VarChar(120)
  authorEmail String   @db.VarChar(191)
  userId      String?  @db.VarChar(64)
  body        String   @db.Text
  /// pending | approved | rejected
  status      String   @default("pending") @db.VarChar(16)
  createdAt   DateTime @default(now())

  @@index([postSlug, locale, status])
  @@index([status, createdAt])
  @@map("blog_comments")
}

/**
 * Interest before launch (or for news).
 */
model WaitlistEntry {
  id        String   @id @db.VarChar(64)
  email     String   @unique @db.VarChar(191)
  name      String?  @db.VarChar(120)
  /// agency | artist | other
  role      String   @default("agency") @db.VarChar(16)
  company   String?  @db.VarChar(191)
  locale    String   @db.VarChar(8)
  /// The referral code or campaign they came with, if any.
  source    String?  @db.VarChar(64)
  createdAt DateTime @default(now())

  @@map("waitlist_entries")
}

/// A request sent to StageDesk itself (the public "request a quote" form). The
/// platform admin offers it to agencies or assigns it; the agency that takes it
/// gets it as a normal booking. Agencies are referenced as agencyId so leads stay
/// platform-level (outside tenantDb).
model Lead {
  id               String        @id @db.VarChar(64)
  /// Shown to the customer, e.g. L-7KQ2M9
  reference        String        @unique @db.VarChar(12)
  /// new | offered | assigned | closed
  status           String        @default("new") @db.VarChar(16)
  name             String        @db.VarChar(191)
  email            String        @db.VarChar(191)
  phone            String?       @db.VarChar(32)
  locale           String        @default("nl") @db.VarChar(8)
  eventType        String        @db.VarChar(24)
  eventDate        DateTime?     @db.Date
  startTime        String?       @db.VarChar(5)
  venueName        String?       @db.VarChar(191)
  venueCity        String?       @db.VarChar(96)
  guestCount       Int?
  budgetRange      String?       @db.VarChar(16)
  preferredGenre   String?       @db.VarChar(96)
  partnerName      String?       @db.VarChar(191)
  ceremony         Boolean?
  message          String?       @db.Text
  assignedAgencyId String?       @db.VarChar(64)
  assignedAgency   Organization? @relation("LeadAgency", fields: [assignedAgencyId], references: [id], onDelete: SetNull)
  bookingId        String?       @unique @db.VarChar(64)
  closedReason     String?       @db.VarChar(191)
  /// Admin's notes, never shown to agencies or the customer.
  adminNotes       String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  offers           LeadOffer[]

  @@index([status, createdAt])
  @@map("leads")
}

/// One agency being offered a lead. The first to accept gets it; the other offers are withdrawn.
model LeadOffer {
  id            String       @id @db.VarChar(64)
  leadId        String       @db.VarChar(64)
  lead          Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agencyId      String       @db.VarChar(64)
  agency        Organization @relation("LeadOffers", fields: [agencyId], references: [id], onDelete: Cascade)
  /// pending | accepted | declined | withdrawn
  status        String       @default("pending") @db.VarChar(16)
  respondedById String?      @db.VarChar(64)
  respondedAt   DateTime?
  createdAt     DateTime     @default(now())

  @@unique([leadId, agencyId])
  @@index([agencyId, status])
  @@map("lead_offers")
}

/// Credentials the platform admin enters in the dashboard (e.g. Stripe keys),
/// encrypted with AES-256-GCM (packages/db/src/secrets.ts). Never sent to a browser;
/// screens show only `hint`.
model PlatformSecret {
  key         String   @id @db.VarChar(64)
  ciphertext  String   @db.Text
  /// e.g. "sk_test_…4242"
  hint        String   @db.VarChar(48)
  updatedById String?  @db.VarChar(64)
  updatedAt   DateTime @updatedAt

  @@map("platform_secrets")
}

/// A customer saying they paid outside Stripe (bank transfer or cash). The agency
/// confirms receipt (which records the Payment) or marks it not received.
model PaymentClaim {
  id             String       @id @db.VarChar(64)
  organizationId String       @db.VarChar(64)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookingId      String       @db.VarChar(64)
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId     String?      @db.VarChar(64)
  /// bank_transfer | cash
  method         String       @db.VarChar(24)
  /// deposit | balance | other
  kind           String       @db.VarChar(16)
  amountCents    Int
  paidOn         DateTime     @db.Date
  /// What the customer wrote in the transfer description, or a note.
  reference      String?      @db.VarChar(191)
  note           String?      @db.Text
  /// pending | confirmed | rejected
  status         String       @default("pending") @db.VarChar(16)
  reviewedById   String?      @db.VarChar(64)
  reviewedAt     DateTime?
  rejectReason   String?      @db.VarChar(191)
  /// The payment recorded when the agency confirmed receipt.
  paymentId      String?      @unique @db.VarChar(64)
  createdAt      DateTime     @default(now())

  @@index([organizationId, status])
  @@index([bookingId])
  @@map("payment_claims")
}
