// StageDesk v2 schema. Conventions:
// - money is integer cents (Int), percentages are basis points (Int)
// - every tenant table gets organizationId + an index on it
// - table names are snake_case plural via @@map

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

// ─── Identity and agencies ──────────────────────────────────────────────
// Managed by Better Auth (apps/web/src/lib/auth-config.ts). Regenerate a
// reference with `pnpm dlx auth generate` after changing plugins, then
// merge by hand: model and field names must match what Better Auth expects.

model User {
  id               String       @id @db.VarChar(64)
  name             String       @db.VarChar(191)
  email            String       @unique @db.VarChar(191)
  emailVerified    Boolean      @default(false)
  image            String?      @db.Text
  twoFactorEnabled Boolean?     @default(false)
  /// "platform_admin" | "affiliate" | null. Never accepted from client input.
  platformRole     String?      @db.VarChar(32)
  locale           String?      @default("nl") @db.VarChar(8)
  phone            String?      @db.VarChar(32)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  sessions         Session[]
  accounts         Account[]
  members          Member[]
  invitations      Invitation[]
  twofactors       TwoFactor[]
  artistProfiles   Artist[]
  bookings         Booking[]    @relation("BookingCustomer")
  reviews          Review[]

  @@map("users")
}

model Session {
  id                   String   @id @db.VarChar(64)
  token                String   @unique @db.VarChar(191)
  expiresAt            DateTime
  ipAddress            String?  @db.VarChar(64)
  userAgent            String?  @db.Text
  userId               String   @db.VarChar(64)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?  @db.VarChar(64)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @db.VarChar(64)
  accountId             String    @db.VarChar(191)
  providerId            String    @db.VarChar(64)
  userId                String    @db.VarChar(64)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @db.VarChar(64)
  identifier String   @db.VarChar(191)
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

/// An agency (tenant).
model Organization {
  id                 String                 @id @db.VarChar(64)
  name               String                 @db.VarChar(191)
  slug               String                 @unique @db.VarChar(191)
  logo               String?                @db.Text
  metadata           String?                @db.Text
  kvkNumber          String?                @db.VarChar(16)
  vatNumber          String?                @db.VarChar(20)
  contactEmail       String?                @db.VarChar(191)
  phone              String?                @db.VarChar(32)
  website            String?                @db.VarChar(191)
  addressLine        String?                @db.VarChar(191)
  postalCode         String?                @db.VarChar(16)
  city               String?                @db.VarChar(96)
  brandColor         String?                @db.VarChar(16)
  /// Public booking page at /b/<slug>.
  bookingPageEnabled Boolean                @default(true)
  bookingIntro       String?                @db.Text
  coverUrl           String?                @db.Text
  /// { question: string; answer: string }[]
  faq                Json?
  showReviews        Boolean                @default(true)
  stripeCustomerId   String?                @unique @db.VarChar(64)
  /// Platform fee deal for this agency (FeeRule); overrides the plan and platform default.
  feeRule            Json?
  createdAt          DateTime               @default(now())
  subscription       Subscription?
  connectedAccounts  ConnectedAccount[]
  ledger             LedgerEntry[]
  members            Member[]
  invitations        Invitation[]
  artists            Artist[]
  unavailable        ArtistUnavailability[]
  sharesOut          ArtistShare[]          @relation("ShareOwner")
  sharesIn           ArtistShare[]          @relation("SharePartner")
  bookings           Booking[]
  assignments        BookingAssignment[]
  events             BookingEvent[]
  notes              BookingNote[]
  services           ServiceItem[]
  quotes             Quote[]
  quoteItems         QuoteItem[]
  payments           Payment[]
  invoices           Invoice[]
  counters           OrganizationCounter[]
  reviews            Review[]

  @@map("organizations")
}

/// A user's role in one agency: agency_owner, agency_admin, agency_staff, artist, customer.
model Member {
  id             String       @id @db.VarChar(64)
  organizationId String       @db.VarChar(64)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @db.VarChar(64)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @db.VarChar(32)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([organizationId, role])
  @@index([userId])
  @@map("members")
}

model Invitation {
  id             String       @id @db.VarChar(64)
  organizationId String       @db.VarChar(64)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @db.VarChar(191)
  role           String?      @db.VarChar(32)
  /// pending | accepted | rejected | canceled
  status         String       @db.VarChar(16)
  expiresAt      DateTime
  inviterId      String       @db.VarChar(64)
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId, status])
  @@index([email])
  @@map("invitations")
}

model TwoFactor {
  id                      String    @id @db.VarChar(64)
  secret                  String    @db.Text
  backupCodes             String    @db.Text
  userId                  String    @db.VarChar(64)
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([userId])
  @@map("two_factors")
}

model RateLimit {
  id          String @id @db.VarChar(64)
  key         String @unique @db.VarChar(191)
  count       Int
  lastRequest BigInt

  @@map("rate_limits")
}

// ─── Artists ────────────────────────────────────────────────────────────

/// A performer an agency books. userId links the artist's own login, if any.
model Artist {
  id                String                 @id @db.VarChar(64)
  organizationId    String                 @db.VarChar(64)
  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId            String?                @db.VarChar(64)
  user              User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  stageName         String                 @db.VarChar(120)
  bio               String?                @db.Text
  /// string[]
  genres            Json
  photoUrl          String?                @db.Text
  /// Shown on the agency's public booking page.
  showOnBookingPage Boolean                @default(true)
  /// string[]: YouTube, Vimeo, SoundCloud or Mixcloud links
  mediaLinks        Json?
  /// Default share of each booking payment, in basis points.
  defaultShareBps   Int                    @default(4000)
  active            Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  assignments       BookingAssignment[]
  unavailability    ArtistUnavailability[]
  shares            ArtistShare[]
  reviews           Review[]
  connectedAccount  ConnectedAccount?

  @@unique([organizationId, userId])
  @@index([organizationId, active])
  @@map("artists")
}

/// Dates an artist can't perform.
model ArtistUnavailability {
  id             String       @id @db.VarChar(64)
  organizationId String       @db.VarChar(64)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  artistId       String       @db.VarChar(64)
  artist         Artist       @relation(fields: [artistId], references: [id], onDelete: Cascade)
  date           DateTime     @db.Date
  note           String?      @db.VarChar(191)
  createdAt      DateTime     @default(now())

  @@unique([artistId, date])
  @@index([organizationId, date])
  @@map("artist_unavailability")
}

/// An agency lending one of its artists to a partner agency.
/// organizationId is the owner; the partner side is read via partnerOrganizationId.
model ArtistShare {
  id                    String       @id @db.VarChar(64)
  organizationId        String       @db.VarChar(64)
  organization          Organization @relation("ShareOwner", fields: [organizationId], references: [id], onDelete: Cascade)
  artistId              String       @db.VarChar(64)
  artist                Artist       @relation(fields: [artistId], references: [id], onDelete: Cascade)
  partnerOrganizationId String       @db.VarChar(64)
  partnerOrganization   Organization @relation("SharePartner", fields: [partnerOrganizationId], references: [id], onDelete: Cascade)
  /// pending | accepted | declined | revoked
  status                String       @db.VarChar(16)
  createdAt             DateTime     @default(now())
  respondedAt           DateTime?

  @@unique([artistId, partnerOrganizationId])
  @@index([organizationId, status])
  @@index([partnerOrganizationId, status])
  @@map("artist_shares")
}

// ─── Bookings ───────────────────────────────────────────────────────────

/// One event for one customer. Status changes go through transition() in core.
model Booking {
  id                String              @id @db.VarChar(64)
  organizationId    String              @db.VarChar(64)
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Public reference, e.g. K7Q2M9XA.
  trackingCode      String              @unique @db.VarChar(8)
  status            String              @default("inquiry") @db.VarChar(16)
  customerId        String?             @db.VarChar(64)
  customer          User?               @relation("BookingCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  eventType         String              @db.VarChar(24)
  eventDate         DateTime?           @db.Date
  startTime         String?             @db.VarChar(5)
  endTime           String?             @db.VarChar(5)
  venueName         String?             @db.VarChar(191)
  venueAddress      String?             @db.VarChar(191)
  venueCity         String?             @db.VarChar(96)
  guestCount        Int?
  budgetCents       Int?
  /// The customer's own words from the inquiry.
  message           String?             @db.Text
  partnerName       String?             @db.VarChar(191)
  /// string[]
  dos               Json?
  /// string[]
  donts             Json?
  playlistUrl       String?             @db.VarChar(500)
  /// From the public inquiry form.
  preferredArtistId String?             @db.VarChar(64)
  preferredGenre    String?             @db.VarChar(96)
  /// Key from core's budgetRanges, e.g. "750_1500".
  budgetRange       String?             @db.VarChar(16)
  ceremony          Boolean?
  /// manual | booking_page
  source            String              @default("manual") @db.VarChar(16)
  /// Copied from the accepted quote.
  totalCents        Int                 @default(0)
  depositCents      Int                 @default(0)
  /// Sum of received payments, kept in step by recordPayment().
  paidCents         Int                 @default(0)
  quoteExpiresAt    DateTime?
  /// { rule: FeeRule; stripeFeePaidBy } frozen when the quote is accepted.
  feeSnapshot       Json?
  /// A customer opened a card dispute; payouts wait until it's resolved.
  disputed          Boolean             @default(false)
  /// When Stripe money was transferred to the agency and artist.
  paidOutAt         DateTime?
  cancelReason      String?             @db.Text
  createdById       String?             @db.VarChar(64)
  quotedAt          DateTime?
  bookedAt          DateTime?
  confirmedAt       DateTime?
  completedAt       DateTime?
  settledAt         DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  assignments       BookingAssignment[]
  events            BookingEvent[]
  notes             BookingNote[]
  quotes            Quote[]
  payments          Payment[]
  invoices          Invoice[]
  review            Review?
  ledger            LedgerEntry[]

  @@index([organizationId, status])
  @@index([organizationId, eventDate])
  @@index([customerId])
  @@map("bookings")
}

/// An artist asked to perform at a booking. One open assignment per booking.
model BookingAssignment {
  id             String       @id @db.VarChar(64)
  organizationId String       @db.VarChar(64)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookingId      String       @db.VarChar(64)
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  artistId       String       @db.VarChar(64)
  artist         Artist       @relation(fields: [artistId], references: [id], onDelete: Restrict)
  /// pending | accepted | declined | withdrawn
  status         String       @db.VarChar(16)
  /// Artist's share for this booking, copied when assigned.
  shareBps       Int
  declineReason  String?      @db.Text
  respondedAt    DateTime?
  createdAt      DateTime     @default(now())

  @@index([bookingId, status])
  @@index([artistId, status])
  @@index([organizationId])
  @@map("booking_assignments")
}

/// Timeline of everything that happened to a booking.
model BookingEvent {
  id             BigInt       @id @default(autoincrement())
  organizationId String       @db.VarChar(64)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookingId      String       @db.VarChar(64)
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type           String       @db.VarChar(32)
  actorId        String?      @db.VarChar(64)
  data           Json?
  createdAt      DateTime     @default(now())

  @@index([bookingId, createdAt])
  @@index([organizationId])
  @@map("booking_events")
}

/// Internal notes; never shown to customers or artists.
model BookingNote {
  id             String       @id @db.VarChar(64)
  organizationId String       @db.VarChar(64)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookingId      String       @db.VarChar(64)
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorId       String       @db.VarChar(64)
  body           String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([bookingId, createdAt])
  @@index([organizationId])
  @@map("booking_notes")
}

// ─── Quotes ─────────────────────────────────────────────────────────────

/// An agency's reusable quote lines, e.g. "DJ, per hour".
model ServiceItem {
  id             String       @id @db.VarChar(64)
  organizationId String       @db.VarChar(64)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String       @db.VarChar(191)
  description    String?      @db.Text
  /// hour | piece | flat
  unit           String       @db.VarChar(16)
  unitPriceCents Int
  vatBps         Int          @default(2100)
  active         Boolean      @default(true)
  position       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, active, position])
  @@map("service_items")
}

/// A versioned price offer for a booking. Totals are stored as sent.
model Quote {
  id             String       @id @db.VarChar(64)
  organizationId String       @db.VarChar(64)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookingId      String       @db.VarChar(64)
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  version        Int
  /// draft | sent | accepted | superseded | declined
  status         String       @db.VarChar(16)
  /// Secret for the customer's /q/<token> link.
  token          String       @unique @db.VarChar(64)
  notes          String?      @db.Text
  depositBps     Int
  subtotalCents  Int
  vatCents       Int
  totalCents     Int
  depositCents   Int
  /// VatGroup[]
  vatGroups      Json
  expiresAt      DateTime
  sentAt         DateTime?
  acceptedAt     DateTime?
  acceptedByName String?      @db.VarChar(191)
  createdById    String?      @db.VarChar(64)
  createdAt      DateTime     @default(now())
  items          QuoteItem[]

  @@unique([bookingId, version])
  @@index([organizationId, status])
  @@map("quotes")
}

model QuoteItem {
  id                 String       @id @db.VarChar(64)
  organizationId     String       @db.VarChar(64)
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quoteId            String       @db.VarChar(64)
  quote              Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  position           Int
  description        String       @db.VarChar(500)
  quantityHundredths Int
  unitPriceCents     Int
  vatBps             Int
  subtotalCents      Int

  @@index([quoteId, position])
  @@index([organizationId])
  @@map("quote_items")
}

// ─── Money ──────────────────────────────────────────────────────────────

/// Money received for a booking: recorded by hand (offline) or paid through Stripe.
model Payment {
  id                    String        @id @db.VarChar(64)
  organizationId        String        @db.VarChar(64)
  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bookingId             String        @db.VarChar(64)
  booking               Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  /// deposit | balance | other | refund (offline refunds are negative amounts)
  kind                  String        @db.VarChar(16)
  /// bank_transfer | cash | card | other | stripe
  method                String        @db.VarChar(24)
  amountCents           Int
  receivedAt            DateTime
  reference             String?       @db.VarChar(191)
  recordedById          String?       @db.VarChar(64)
  stripeCheckoutId      String?       @unique @db.VarChar(80)
  stripePaymentIntentId String?       @unique @db.VarChar(64)
  stripeChargeId        String?       @db.VarChar(64)
  stripeFeeCents        Int           @default(0)
  refundedCents         Int           @default(0)
  /// When this payment's split was transferred to the agency and artist.
  transferredAt         DateTime?
  createdAt             DateTime      @default(now())
  ledger                LedgerEntry[]

  @@index([bookingId])
  @@index([organizationId, receivedAt])
  @@map("payments")
}

/// Append-only record of every money movement. Amounts are signed cents
/// from the point of view of `party`; nothing here is ever edited.
model LedgerEntry {
  id             BigInt       @id @default(autoincrement())
  organizationId String       @db.VarChar(64)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bookingId      String?      @db.VarChar(64)
  booking        Booking?     @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  paymentId      String?      @db.VarChar(64)
  payment        Payment?     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  /// payment | stripe_fee | platform_fee | artist_share | agency_share | transfer | refund | transfer_reversal | dispute | owed_by_agency
  type           String       @db.VarChar(32)
  /// platform | agency | artist | stripe | customer
  party          String       @db.VarChar(16)
  amountCents    Int
  artistId       String?      @db.VarChar(64)
  stripeObjectId String?      @db.VarChar(64)
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([bookingId])
  @@index([artistId, type])
  @@map("ledger_entries")
}

// ─── Subscriptions and Stripe ───────────────────────────────────────────

/// A subscription plan, edited by the super admin and mirrored to Stripe.
model Plan {
  id                   String         @id @db.VarChar(64)
  key                  String         @unique @db.VarChar(48)
  /// { nl, en }
  name                 Json
  /// { nl, en }
  description          Json?
  monthlyPriceCents    Int
  yearlyPriceCents     Int
  trialDays            Int            @default(14)
  /// { nl: string[]; en: string[] } shown on the pricing page
  features             Json
  /// PlanLimits from @stagedesk/core
  limits               Json
  /// FeeRule for agencies on this plan; null uses the platform default.
  feeRule              Json?
  recommended          Boolean        @default(false)
  visible              Boolean        @default(true)
  active               Boolean        @default(true)
  position             Int            @default(0)
  stripeProductId      String?        @db.VarChar(64)
  stripeMonthlyPriceId String?        @db.VarChar(64)
  stripeYearlyPriceId  String?        @db.VarChar(64)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  subscriptions        Subscription[]

  @@map("plans")
}

/// An agency's subscription. Mirrors Stripe once the agency has paid.
model Subscription {
  id                   String       @id @db.VarChar(64)
  organizationId       String       @unique @db.VarChar(64)
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId               String       @db.VarChar(64)
  plan                 Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  /// trialing | active | past_due | unpaid | canceled | incomplete
  status               String       @db.VarChar(24)
  /// month | year
  interval             String       @default("month") @db.VarChar(8)
  stripeSubscriptionId String?      @unique @db.VarChar(64)
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean      @default(false)
  /// Start of a failed-payment period; read-only access begins after the grace days.
  pastDueSince         DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([status])
  @@map("subscriptions")
}

/// A Stripe Express account for an agency (receives its share) or an artist.
model ConnectedAccount {
  id               String       @id @db.VarChar(64)
  organizationId   String       @db.VarChar(64)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Set for an artist's account; null for the agency's own.
  artistId         String?      @unique @db.VarChar(64)
  artist           Artist?      @relation(fields: [artistId], references: [id], onDelete: Cascade)
  stripeAccountId  String       @unique @db.VarChar(64)
  chargesEnabled   Boolean      @default(false)
  payoutsEnabled   Boolean      @default(false)
  detailsSubmitted Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId])
  @@map("connected_accounts")
}

/// Every Stripe webhook event, stored once by id so it's processed at most once.
model StripeEvent {
  id          String    @id @db.VarChar(80)
  type        String    @db.VarChar(80)
  /// received | processed | failed | ignored
  status      String    @default("received") @db.VarChar(16)
  error       String?   @db.Text
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([status, receivedAt])
  @@map("stripe_events")
}

/// Issued invoice. `data` is a snapshot so later edits don't change it.
model Invoice {
  id             String       @id @db.VarChar(64)
  organizationId String       @db.VarChar(64)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bookingId      String       @db.VarChar(64)
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  number         String       @db.VarChar(16)
  issuedAt       DateTime
  dueAt          DateTime?
  subtotalCents  Int
  vatCents       Int
  totalCents     Int
  data           Json
  createdAt      DateTime     @default(now())

  @@unique([organizationId, number])
  @@index([bookingId])
  @@map("invoices")
}

/// Per-agency sequences, e.g. invoice numbers per year.
model OrganizationCounter {
  organizationId String       @db.VarChar(64)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String       @db.VarChar(32)
  value          Int

  @@id([organizationId, key])
  @@map("organization_counters")
}

/// A customer's review after a completed booking; shown once approved.
model Review {
  id             String       @id @db.VarChar(64)
  organizationId String       @db.VarChar(64)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookingId      String       @unique @db.VarChar(64)
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId     String       @db.VarChar(64)
  customer       User         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  artistId       String?      @db.VarChar(64)
  artist         Artist?      @relation(fields: [artistId], references: [id], onDelete: SetNull)
  rating         Int
  comment        String?      @db.Text
  /// pending | approved | rejected
  status         String       @default("pending") @db.VarChar(16)
  moderatedAt    DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, status])
  @@index([artistId, status])
  @@map("reviews")
}

// ─── Platform settings ──────────────────────────────────────────────────

/// Typed key/value settings edited by the super admin. Keys and shapes are
/// defined in @stagedesk/core settingsRegistry.
model PlatformSetting {
  key         String   @id @db.VarChar(100)
  value       Json
  updatedById String?  @db.VarChar(64)
  updatedAt   DateTime @updatedAt

  @@map("platform_settings")
}

/// Append-only history of every settings change.
model SettingChange {
  id          BigInt   @id @default(autoincrement())
  key         String   @db.VarChar(100)
  oldValue    Json?
  newValue    Json
  changedById String?  @db.VarChar(64)
  changedAt   DateTime @default(now())

  @@index([key, changedAt])
  @@map("settings_history")
}
