# Copy to .env (repo root). Values below match docker/compose.dev.yml.

# App
NODE_ENV=development
APP_URL=http://localhost:3000

# Database (MySQL 8.4 in Docker, port 3307 to avoid XAMPP)
DATABASE_URL=mysql://stagedesk:stagedesk@localhost:3307/stagedesk
SHADOW_DATABASE_URL=mysql://stagedesk:stagedesk@localhost:3307/stagedesk_shadow

# Redis (BullMQ jobs)
REDIS_URL=redis://localhost:6379

# S3-compatible storage (RustFS locally; R2/S3 in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=stagedesk
S3_SECRET_KEY=stagedesk-secret
S3_BUCKET_PUBLIC=stagedesk-public
S3_BUCKET_PRIVATE=stagedesk-private

# Email (Mailpit locally: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="StageDesk <no-reply@stagedesk.local>"

# Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Stripe (test mode keys from dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare Turnstile (spam protection on public forms). These are Cloudflare's
# always-pass test keys; use real keys from dash.cloudflare.com in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
