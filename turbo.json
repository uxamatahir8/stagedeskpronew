{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "NODE_ENV"
  ],
  "globalDependencies": [
    ".env"
  ],
  "globalPassThroughEnv": [
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_USER",
    "SMTP_PASSWORD",
    "MAIL_FROM"
  ],
  "tasks": {
    "generate": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^generate",
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "APP_URL",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_SECRET",
        "SECRETS_KEY",
        "S3_*",
        "STRIPE_*",
        "TURNSTILE_*",
        "SITES_*",
        "TRUSTED_PROXIES",
        "HEALTH_TOKEN",
        "GEOCODER_URL"
      ]
    },
    "dev": {
      "dependsOn": [
        "^generate"
      ],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": [
        "generate",
        "^generate"
      ]
    },
    "test": {
      "dependsOn": [
        "generate",
        "^generate"
      ],
      "env": [
        "DATABASE_URL",
        "TEST_DATABASE_URL"
      ],
      "passThroughEnv": [
        "REDIS_URL",
        "STRIPE_MOCK_URL",
        "BETTER_AUTH_SECRET",
        "SECRETS_KEY"
      ]
    },
    "@stagedesk/payments#test": {
      "dependsOn": [
        "generate",
        "^generate",
        "@stagedesk/db#test"
      ],
      "env": [
        "DATABASE_URL",
        "TEST_DATABASE_URL"
      ],
      "passThroughEnv": [
        "REDIS_URL",
        "STRIPE_MOCK_URL",
        "BETTER_AUTH_SECRET",
        "SECRETS_KEY"
      ]
    },
    "@stagedesk/web#test": {
      "dependsOn": [
        "generate",
        "^generate",
        "@stagedesk/payments#test"
      ],
      "env": [
        "DATABASE_URL",
        "TEST_DATABASE_URL"
      ],
      "passThroughEnv": [
        "REDIS_URL",
        "STRIPE_MOCK_URL",
        "BETTER_AUTH_SECRET",
        "SECRETS_KEY"
      ]
    }
  }
}
