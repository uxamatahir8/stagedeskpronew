{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["NODE_ENV"],
  "globalDependencies": [".env"],
  "globalPassThroughEnv": ["SMTP_HOST", "SMTP_PORT", "SMTP_USER", "SMTP_PASSWORD", "MAIL_FROM"],
  "tasks": {
    "generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^generate", "^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["generate", "^generate"]
    },
    "test": {
      "dependsOn": ["generate", "^generate"],
      "env": ["DATABASE_URL", "TEST_DATABASE_URL"]
    },
    "@stagedesk/payments#test": {
      "dependsOn": ["generate", "^generate", "@stagedesk/db#test"],
      "env": ["DATABASE_URL", "TEST_DATABASE_URL"]
    }
  }
}
